      "result": {
        "type": "number",
        "dimensionality": "scalar"
      },
      "parameters": [
        {
          "name": "p",
          "description": "Pressure (psia)",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "T",
          "description": "Temperature (°F)",
          "type": "number",
