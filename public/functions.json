{
  "functions": [
    {
      "id": "ASK",
      "name": "ASK",
      "description": "Ask Gemini and return a short answer in the cell. Example: =ZEE.ASK(\"Classify this failure\", B2)",
      "helpUrl": "https://aistudio.google.com/",
      "result": {
        "type": "string",
        "dimensionality": "scalar"
      },
      "parameters": [
        {
          "name": "prompt",
          "description": "What to ask or do, e.g. \"Extract the city\".",
          "type": "string",
          "dimensionality": "scalar"
        },
        {
          "name": "context",
          "description": "Optional cells or ranges the prompt applies to.",
          "type": "any",
          "dimensionality": "matrix",
          "optional": true,
          "repeating": true
        }
      ],
      "options": {
        "cancelable": true
      }
    },
    {
      "id": "VOGEL",
      "name": "VOGEL",
      "description": "Vogel IPR: liquid rate (bbl/d) at a flowing pressure, from reservoir pressure and one well test. =ZEE.VOGEL(Pr, Pwf, q_test, Pwf_test)",
      "result": {
        "type": "number",
        "dimensionality": "scalar"
      },
      "parameters": [
        {
          "name": "Pr",
          "description": "Average reservoir pressure (psia)",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "Pwf",
          "description": "Flowing bottom-hole pressure to evaluate (psia)",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "q_test",
          "description": "Test rate (bbl/d)",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "Pwf_test",
          "description": "Flowing pressure during the test (psia)",
          "type": "number",
          "dimensionality": "scalar"
        }
      ]
    },
    {
      "id": "VOGEL_QMAX",
      "name": "VOGEL_QMAX",
      "description": "Vogel absolute open flow (q at Pwf = 0, bbl/d) from one well test. =ZEE.VOGEL_QMAX(Pr, q_test, Pwf_test)",
      "result": {
        "type": "number",
        "dimensionality": "scalar"
      },
      "parameters": [
        {
          "name": "Pr",
          "description": "Average reservoir pressure (psia)",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "q_test",
          "description": "Test rate (bbl/d)",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "Pwf_test",
          "description": "Flowing pressure during the test (psia)",
          "type": "number",
          "dimensionality": "scalar"
        }
      ]
    },
    {
      "id": "PI",
      "name": "PI",
      "description": "Productivity index J = q / (Pr − Pwf), bbl/d/psi.",
      "result": {
        "type": "number",
        "dimensionality": "scalar"
      },
      "parameters": [
        {
          "name": "q",
          "description": "Rate (bbl/d)",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "Pr",
          "description": "Reservoir pressure (psia)",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "Pwf",
          "description": "Flowing bottom-hole pressure (psia)",
          "type": "number",
          "dimensionality": "scalar"
        }
      ]
    },
    {
      "id": "RS",
      "name": "RS",
